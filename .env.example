# PUBG API
PUBG_API_KEY=your_api_key_here
API_CALLS_LIMIT=10
PUBG_SHARD=steam

# Pipeline config
PLAYER_NAMES=v1t1n
# Most recent matches per player (0 = all the API returns, ~14 days)
MAX_MATCHES_PER_PLAYER=10

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pubg
POSTGRES_USER=pubg
POSTGRES_PASSWORD=pubg_secret
